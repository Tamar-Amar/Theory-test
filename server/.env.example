# העתיקי ל־.env וערכי לפי הצורך.
# שימי לב: כל המשתנים כאן נדרשים (אין ערכי ברירת מחדל בקוד).

PORT=4000

# מונגו: מקומי או Atlas. אחרי .net/ בשורת srv — שם מסד הנתונים
MONGODB_URI=mongodb://127.0.0.1:27017/theory_quiz
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/theory_quiz?retryWrites=true&w=majority

JWT_SECRET=החליפי-למחרוזת-ארוכה-ואקראית
JWT_EXPIRES_DAYS=14

# מנהל (כניסה מסך התחברות)
ADMIN_USERNAME=תמר
ADMIN_PASSWORD=תמר

CORS_ORIGINS=http://localhost:5173
# בפרודקשן לדוגמה:
# CORS_ORIGINS=https://your-app.vercel.app

# 0 = ללא מחיקה אוטומטית; מספר חיובי = TTL בשניות
ATTEMPT_EXPIRE_AFTER_SECONDS=0
