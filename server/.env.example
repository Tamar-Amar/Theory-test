PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/theory
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=14
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
ATTEMPT_EXPIRE_AFTER_SECONDS=0
# כתובת האתר לקישורי איפוס סיסמה (אופציונלי; ברירת מחדל = origin ראשון ב-CORS)
CLIENT_APP_URL=http://localhost:5173
# שליחת מייל לאיפוס סיסמה (אופציונלי בפיתוח — בלי SMTP הקישור נכתב ללוג השרת)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Theory <noreply@example.com>
# SMTP_SECURE=true
